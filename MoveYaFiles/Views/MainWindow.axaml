<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoveYaFiles.ViewModels"
        x:Class="MoveYaFiles.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MoveYaFiles"
        Width="600" Height="650"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer Margin="20">
        <StackPanel Spacing="15">

            <!-- Tytuł -->
            <TextBlock Text="MoveYaFiles" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" />

            <!-- Sekcja 1: Lista reguł (Multi-Rule) -->
            <Grid ColumnDefinitions="*, Auto, Auto">
                <ListBox Grid.Column="0" 
                         ItemsSource="{Binding Rules}" 
                         SelectedItem="{Binding SelectedRule}" 
                         Height="90" 
                         Margin="0,0,10,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Top">
                    <Button Content="Add Rule" Click="AddRule_Click" Width="90"/>
                    <Button Content="Remove" Click="RemoveRule_Click" IsEnabled="{Binding HasSelectedRule}" Width="90"/>
                </StackPanel>
            </Grid>

            <!-- Sekcja 2: Edycja ścieżek wybranej reguły -->
            <StackPanel Spacing="10" IsEnabled="{Binding HasSelectedRule}">
                <!-- Foldery -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                    <TextBox Grid.Column="0" Text="{Binding SelectedRule.SourcePath}" PlaceholderText="Source Folder Path" Margin="0,0,5,0"/>
                    <Button Grid.Column="1" Content="Browse..." Click="SelectSourceFolder_Click"/>
                </Grid>

                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                    <TextBox Grid.Column="0" Text="{Binding SelectedRule.DestinationPath}" PlaceholderText="Destination Folder Path" Margin="0,0,5,0"/>
                    <Button Grid.Column="1" Content="Browse..." Click="SelectDestinationFolder_Click"/>
                </Grid>

                <!-- Filtry i Interwał -->
                <TextBox Text="{Binding FileExtensions}" PlaceholderText="Allowed extensions (e.g. .pdf, .zip)" />

                <!-- Opcje konfliktów i sufiks -->
                <Grid ColumnDefinitions="*, *">
                    <ComboBox Grid.Column="0" 
                              ItemsSource="{Binding ConflictStrategies}" 
                              SelectedItem="{Binding SelectedConflictStrategy}" 
                              HorizontalAlignment="Stretch" 
                              Margin="0,0,5,0"/>

                    <TextBox Grid.Column="1" 
                             Text="{Binding CustomSuffix}" 
                             PlaceholderText="Custom Suffix (e.g. _copy)" 
                             IsEnabled="{Binding IsCustomSuffixEnabled}" 
                             Margin="5,0,0,0"/>
                </Grid>

                <!-- Interwał czasowy -->
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Text="Interval:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding IntervalOptions.Keys}" 
                              SelectedItem="{Binding SelectedInterval}" 
                              HorizontalAlignment="Stretch"/>
                </Grid>
            </StackPanel>

            <Separator Margin="0,10"/>

            <!-- Sekcja 3: Status i Automatyzacja -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="{Binding LastSyncText}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding NextSyncText}" 
                           Foreground="Green" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>

                <Button Content="Run archiving now" Command="{Binding RunArchivingCommand}" HorizontalAlignment="Center"/>
                <CheckBox Content="Start with Windows" IsChecked="{Binding RunAtStartup}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" Foreground="Gray" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>