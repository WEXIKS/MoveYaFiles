<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoveYaFiles.ViewModels"
        x:Class="MoveYaFiles.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MoveYaFiles - Archive manager"
        Width="550" Height="400"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <StackPanel Margin="20" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="MoveYaFiles" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>

        <Grid ColumnDefinitions="*, *" Margin="0,0,0,10">
            <ComboBox Grid.Column="0" 
                      ItemsSource="{Binding ConflictStrategies}" 
                      SelectedItem="{Binding SelectedConflictStrategy}" 
                      HorizontalAlignment="Stretch" 
                      Margin="0,0,5,0"/>

            <TextBox Grid.Column="1" 
                     Text="{Binding CustomSuffix}" 
                     PlaceholderText="Custom Suffix (e.g. _v2)" 
                     IsEnabled="{Binding IsCustomSuffixEnabled}" 
                     Margin="5,0,0,0"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
            <TextBlock Text="Last sync:" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding LastRunText}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
            <TextBlock Text="Next automatization in:" Foreground="Gray"/>
            <TextBlock Text="{Binding CountdownText}" FontWeight="Bold" Foreground="LimeGreen"/>
        </StackPanel>

        <Button Content="Run archiving now" 
                Command="{Binding RunTransfer}" 
                HorizontalAlignment="Center" 
                Padding="15,8"/>

        <TextBlock Text="{Binding StatusMessage}" 
                   HorizontalAlignment="Center" 
                   FontStyle="Italic" 
                   Foreground="Gray"/>
    </StackPanel>
</Window>